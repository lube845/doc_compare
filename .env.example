# Docker Compose 环境变量示例，复制为 .env 后按需修改

# 端口
FRONTEND_PORT=8080
BACKEND_PORT=8000

# 是否在后端镜像中安装 LibreOffice
#   true  -> DOC / WPS / ET 可完整还原结构（镜像约 1.2 GB，首次构建需下载约 700 MB）
#   false -> 走内置兼容解析（镜像约 350 MB，DOC/WPS/ET 标记为 partial）
# 修改后需执行 docker compose up -d --build 重新构建
INSTALL_LIBREOFFICE=true

# PostgreSQL
POSTGRES_USER=doccompare
POSTGRES_PASSWORD=doccompare
POSTGRES_DB=doccompare

# 上传大小上限（字节），默认 100 MB
MAX_UPLOAD_SIZE=104857600

# 允许的前端来源
CORS_ORIGINS=http://localhost:8080

# OCR · 扫描件识别（渠道可在界面切换，默认百度）
# 扫描件（没有文本层的 PDF）会被渲染成图片交给所选渠道识别，识别结果带坐标，
# 因此扫描件也能参与比对，前端也能高亮差异位置。
#
# 推荐在界面里配置：导航栏的「设置」页选择渠道（百度 / 腾讯云 / 通用 HTTP 接口）
# 并填写凭证，测试连接通过后才能保存，保存后立即生效，不需要重新构建镜像。
# 下面的环境变量是**尚未在界面配置时的默认值**——界面一旦保存过，以界面为准。
#
# 申请方式：
#   百度：百度智能云控制台 -> 文字识别 -> 开通服务 -> 访问控制 -> API 密钥管理
#   腾讯云：腾讯云控制台 -> 访问管理 -> API 密钥管理
#
# 不配置 OCR_PROVIDER 时行为与之前完全一致：扫描件返回 unsupported_ocr。
OCR_PROVIDER=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
# 中英文混合（默认）；也可填 ENG / JAP / KOR / FRE / SPA / POR / GER / ITA / RUS
BAIDU_OCR_LANGUAGE_TYPE=CHN_ENG
# 渲染分辨率，越高越准也越慢（百度要求图片最长边不超过 4096px，会自动降级）
BAIDU_OCR_DPI=200
# 单个文件最多识别多少页（控制费用），超出的页不识别
BAIDU_OCR_MAX_PAGES=100

# 「通用 HTTP 接口」是否允许指向内网地址（自建 OCR 服务）
#   0 -> 只允许公网地址（默认）：避免服务端被利用去访问云元数据或内网端口
#   1 -> 允许内网/回环地址
OCR_ALLOW_PRIVATE_ENDPOINTS=0
